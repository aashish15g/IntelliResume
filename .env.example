# Copy to .env and replace these placeholders locally. Never commit .env.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-local-secret
GEMINI_API_KEY=replace-with-your-gemini-api-key
ADZUNA_APP_ID=replace-with-your-adzuna-app-id
ADZUNA_API_KEY=replace-with-your-adzuna-api-key
